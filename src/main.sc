require: slotfilling/slotFilling.sc
  module = sys.zb-common
theme: /

require: intents.sc
  file: classifier/intents.sc

theme: /

    state: /hello
        intent!: /hello
        q!: Hello | hi | привет | здравствуй* | добрый день | добрый вечер | доброе утро | хай | хэй | ку | приветствую
        a: Привет! Я бот-помощник 🤖 Я могу рассказать о погоде и курсах валют. Попробуйте спросить: «Какая погода?» или «Какой курс доллара?»

    state: /weather
        intent!: /weather
        q!: * погод* | какая погода | узнать погоду | прогноз погоды | погода сегодня | погода на завтра | что с погодой | расскажи про погоду | как там погода | температура на улице | будет ли дождь | нужна ли куртка | тепло ли на улице
        a: 🌤 Сейчас я не подключён к реальному сервису погоды, но могу сказать, что за окном — погода! Для точного прогноза рекомендую проверить weather.com или Яндекс.Погоду 😊

    state: /currency
        intent!: /currency
        q!: * курс* | курс валют | курс доллара | курс евро | курс рубля | какой курс | валюта сегодня | сколько стоит доллар | сколько стоит евро | узнать курс | обменный курс | курс на сегодня | валютный курс | конвертация валют | поменять валюту
        a: 💱 Я пока не подключён к реальному источнику курсов валют. Актуальные курсы можно посмотреть на сайте ЦБ РФ: cbr.ru или в приложении вашего банка 📊

    state: /NoMatch
        event!: noMatch
        a: Извините, я не понял ваш запрос 🤔 Я умею отвечать на вопросы о погоде и курсах валют. Попробуйте спросить: «Какая погода?» или «Какой курс доллара?»